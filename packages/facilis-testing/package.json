{
    "name": "facilis-testing",
    "version": "0.0.1",
    "description": "Testing helpers for Facilis formats and adapters.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "test": "node -e \"console.log('facilis-testing: no tests defined yet')\"",
        "test:watch": "node -e \"console.log('facilis-testing: no watch tests defined yet')\""
    },
    "keywords": [
        "facilis",
        "testing",
        "format",
        "input",
        "formatter"
    ],
    "license": "MIT",
    "peerDependencies": {
        "facilis": "0.0.1"
    },
    "devDependencies": {
        "@types/node": "^26.0.1",
        "facilis": "0.0.1"
    }
}
