{
    "name": "facilis",
    "version": "0.2.0",
    "description": "A framework-agnostic input formatting library.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [
        "facilis",
        "format",
        "input",
        "mask",
        "formatter"
    ],
    "license": "MIT",
    "dependencies": {
        "runtime-reporter": "^0.10.1"
    },
    "devDependencies": {
        "@types/node": "^26.0.1",
        "facilis-testing": "^0.2.0",
        "vitest": "^4.1.9"
    }
}
