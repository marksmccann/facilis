{
    "name": "facilis-react",
    "version": "0.2.0",
    "description": "React adapter for the Facilis input formatting library.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "test": "vitest run --environment jsdom",
        "test:watch": "vitest --environment jsdom"
    },
    "keywords": [
        "facilis",
        "react",
        "format",
        "input",
        "formatter"
    ],
    "license": "MIT",
    "dependencies": {
        "facilis": "^0.2.0",
        "uncontrollable": "^9.0.0"
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "jsdom": "^29.1.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "vitest": "^4.1.9"
    }
}
