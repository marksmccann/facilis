{
    "name": "facilis-react",
    "version": "0.0.1",
    "description": "React adapter for the Facilis input formatting library.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "test": "node -e \"console.log('facilis-react: no tests defined yet')\"",
        "test:watch": "node -e \"console.log('facilis-react: no watch tests defined yet')\""
    },
    "keywords": [
        "facilis",
        "react",
        "format",
        "input",
        "formatter"
    ],
    "license": "MIT",
    "dependencies": {
        "facilis": "0.0.1"
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "devDependencies": {
        "@types/react": "^19.2.17",
        "react": "^19.2.7"
    }
}
