---
import FormatDemoLayout from '../../../components/FormatDemoLayout.astro';
---

<FormatDemoLayout
    apiHref="/facilis/reference/formats/credit-card/"
    title="creditCard() Demo"
>
    <article class="demo-card">
        <h2>Default grouping</h2>
        <p>Most cards format as four groups of four digits.</p>
        <label class="demo-label" for="credit-card-default">Type a card number</label>
        <input class="demo-input" id="credit-card-default" data-demo-credit-card-default type="text" placeholder="Try 4111111111111111" />
        <p class="demo-note">Try <code>4111111111111111</code> to see <code>4111 1111 1111 1111</code>.</p>
    </article>

    <article class="demo-card">
        <h2>American Express layout</h2>
        <p>American Express numbers switch to a <code>4-6-5</code> grouping automatically.</p>
        <label class="demo-label" for="credit-card-amex">Type an AmEx number</label>
        <input class="demo-input" id="credit-card-amex" data-demo-credit-card-amex type="text" placeholder="Try 378282246310005" />
        <p class="demo-note">Try <code>378282246310005</code> to see <code>3782 822463 10005</code>.</p>
    </article>

    <article class="demo-card">
        <h2>Digit-only normalization</h2>
        <p>Non-digit characters are ignored, and extra digits beyond the active card length are dropped.</p>
        <label class="demo-label" for="credit-card-mixed">Paste mixed input</label>
        <input class="demo-input" id="credit-card-mixed" data-demo-credit-card-mixed type="text" placeholder="Try 4111-1111 1111 1111 9999" />
        <p class="demo-note">This scenario keeps only digits and caps the result to the active card layout.</p>
    </article>

    <script>
        import { mountCreditCardDemo } from '../../../demo/mountFormatDemos.ts';

        mountCreditCardDemo();
    </script>
</FormatDemoLayout>
