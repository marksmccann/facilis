---
import FormatDemoLayout from '../../../components/FormatDemoLayout.astro';
---

<FormatDemoLayout apiHref="/facilis/reference/formats/ein/" title="ein() Demo">
    <article class="demo-card">
        <h2>Default formatting</h2>
        <p>Employer Identification Numbers use the standard 9-digit EIN layout while the format strips anything that is not a digit.</p>
        <label class="demo-label" for="ein-default">EIN</label>
        <input class="demo-input" id="ein-default" data-demo-ein-default type="text" placeholder="Try 123456789" />
        <p class="demo-note">Try <code>123456789</code> to see the default grouping: <code>12-3456789</code>.</p>
    </article>

    <article class="demo-card">
        <h2>Paste cleanup</h2>
        <p>Existing hyphens, spaces, and other characters are ignored so pasted text resolves to the same EIN shape.</p>
        <label class="demo-label" for="ein-paste">Messy EIN</label>
        <input class="demo-input" id="ein-paste" data-demo-ein-paste type="text" placeholder="Try 12 3456789 ext. 0" />
        <p class="demo-note">Try <code>12 3456789 ext. 0</code>. The format keeps the first 9 digits and displays them as an EIN.</p>
    </article>

    <script>
        import { mountEinDemo } from '../../../demo/mountFormatDemos.ts';

        mountEinDemo();
    </script>
</FormatDemoLayout>
